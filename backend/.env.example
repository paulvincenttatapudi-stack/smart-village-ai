# App
APP_NAME="Smart Village AI Platform"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_village
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/smart_village

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
SECRET_KEY=change-this-to-a-very-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Upload
UPLOAD_DIR=static/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.gif,.webp
ALLOWED_AUDIO_EXTENSIONS=.mp3,.wav,.ogg,.m4a
ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.doc,.docx

# Storage (local, s3, cloudinary)
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI
AI_MODEL_CACHE_DIR=./models
ENABLE_GPU=false
DUPLICATE_RADIUS_METERS=500
SIMILARITY_THRESHOLD=0.75

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@smartvillage.gov
