# Smart Village AI Platform - Production Environment Template
# Copy to your host (Railway/Render/Docker) as environment variables.
# NEVER commit real secrets to the repository.

# --- Core ---
APP_NAME=Smart Village AI Platform
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# --- Database (PostgreSQL). Railway/Neon provide the connection string. ---
# Async driver for the app:
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/smart_village
# Sync driver (used by Alembic migrations):
DATABASE_URL_SYNC=postgresql://USER:PASSWORD@HOST:5432/smart_village

# --- Redis / Celery (optional - enable for background task processing) ---
REDIS_URL=redis://HOST:6379/0
CELERY_BROKER_URL=redis://HOST:6379/1
CELERY_RESULT_BACKEND=redis://HOST:6379/2

# --- Security: REQUIRED. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))" ---
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# --- Uploads (local storage is fine on Railway with a volume) ---
UPLOAD_DIR=static/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.gif,.webp
ALLOWED_AUDIO_EXTENSIONS=.mp3,.wav,.ogg,.m4a
ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.doc,.docx

# --- Storage backend: local | s3 | cloudinary ---
STORAGE_BACKEND=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- AI ---
AI_MODEL_CACHE_DIR=./models
ENABLE_GPU=false
DUPLICATE_RADIUS_METERS=500.0
SIMILARITY_THRESHOLD=0.75

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Email (optional) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=noreply@smartvillage.gov
